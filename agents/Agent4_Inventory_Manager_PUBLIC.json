    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst inventoryList = items.map(item => {\n  const d = item.json;\n  const daysLeft = d.daily_usage > 0 ? (d.quantity / d.daily_usage).toFixed(1) : 'N/A';\n  const status = d.quantity <= d.threshold ? '⚠️ LOW' : '✅ OK';\n  return `- ${d.ingredient}: ${d.quantity} ${d.unit} (threshold: ${d.threshold}, daily use: ${d.daily_usage}, days left: ${daysLeft}) [${status}]`;\n}).join('\\n');\n\nconst prompt = `You are an inventory manager for a restaurant. Analyze the current stock and provide:\n1. List of items that need restocking (quantity <= threshold)\n2. Recommended order quantity for each low item (enough for 7 days)\n3. Brief overall assessment\n\nCurrent inventory:\n${inventoryList}\n\nRespond in JSON format:\n{\n  \"alerts\": [{\"ingredient\": \"...\", \"current\": 0, \"threshold\": 0, \"order_qty\": 0, \"unit\": \"...\"}],\n  \"ok_items\": [\"...\"],\n  \"assessment\": \"...\",\n  \"has_alerts\": true/false\n}`;\n\nreturn [{ json: { prompt, inventory_snapshot: inventoryList } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
