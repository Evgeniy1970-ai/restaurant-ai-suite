    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst raw = response.output[0].content[0].text;\n\nconst cleaned = raw.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n  parsed.parse_error = false;\n} catch(e) {\n  parsed = {\n    alerts: [],\n    ok_items: [],\n    assessment: \"Failed to parse AI response: \" + e.message,\n    has_alerts: false,\n    parse_error: true\n  };\n}\n\nreturn [{ json: parsed }];"
      },
