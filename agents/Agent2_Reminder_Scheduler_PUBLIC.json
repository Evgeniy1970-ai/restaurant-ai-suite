{
  "name": "Restaurant AI Suite_2_Reminder_Scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 10
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "id": "4046a767-9319-4ff1-8360-c089dbe94ef8",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "reservations",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "reminder_sent",
              "condition": "is",
              "keyValue": "false"
            },
            {
              "keyName": "reservation_date",
              "condition": "eq",
              "keyValue": "={{ new Date(Date.now() + 86400000).toISOString().split('T')[0] }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        208,
        0
      ],
      "id": "d3a773ce-95d8-4bf1-a9fe-5fdd9b159c9a",
      "name": "Get many rows",
      "credentials": {
        "supabaseApi": {
          "id": "YOUR_SUPABASE_CREDENTIAL_ID",
          "name": "restaurant-ai-suite"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.guest_email }}",
        "subject": "=Напоминание о бронировании — {{ $json.reservation_date }}",
        "message": "=<h2>Напоминание о вашем визите! 🔔</h2>\n<p>Уважаемый(ая) {{ $json.guest_name }},</p>\n<p>Напоминаем, что завтра вас ждём в ресторане:</p>\n<ul>\n  <li>📅 Дата: {{ $json.reservation_date }}</li>\n  <li>⏰ Время: {{ $json.reservation_time }}</li>\n  <li>👥 Гостей: {{ $json.party_size }}</li>\n</ul>\n<p>Будем рады вас видеть!</p>",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        416,
        0
      ],
      "id": "2a0b040e-ef4c-401a-8d1b-953b07268880",
      "name": "Send a message",
      "webhookId": "bf8293cb-2143-456e-969b-cffdbc44d14f",
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "reservations",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Get many rows').first().json.id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "reminder_sent",
              "fieldValue": "true"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        624,
        0
      ],
      "id": "4348df10-50f2-4222-8aec-0ef3e55e2c13",
      "name": "Update a row",
      "credentials": {
        "supabaseApi": {
          "id": "YOUR_SUPABASE_CREDENTIAL_ID",
          "name": "restaurant-ai-suite"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get many rows",
