        "responses": {
          "values": [
            {
              "content": "=Analyze the following restaurant review and respond ONLY with a valid JSON object, no other text.\n\nReview: {{ $json.snippet }}\nRating: {{ $json.rating }}/5\n\nReturn exactly this JSON structure:\n{\n  \"sentiment\": \"positive\" or \"neutral\" or \"negative\",\n  \"sentiment_score\": a number from 0.0 to 1.0,\n  \"summary\": \"one sentence summary in English\",\n  \"key_topics\": [\"topic1\", \"topic2\"]\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [1220, -60],
      "id": "4e0e72b8-ad92-427a-91e4-947548a57343",
      "name": "🤖 AI Sentiment Analysis",
      "onError": "continueErrorOutput",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const aiText = item.json.output[0].content[0].text;\n\n  let parsed;\n  try {\n    // Strip markdown code fences if present\n    const clean = aiText.replace(/```json|```/g, '').trim();\n    parsed = JSON.parse(clean);\n  } catch (e) {\n    parsed = {\n      sentiment: 'neutral',\n      sentiment_score: 0.5,\n      summary: 'Could not parse AI response',\n      key_topics: []\n    };\n  }\n\n  const platform = item.json.platform || 'google';\n  const externalId = item.json.review_id ? item.json.review_id.toString() : null;\n\n  results.push({\n    json: {\n      restaurant_id: 'e12f1eae-f48d-4c5f-ac9b-b9fd0f84e754',\n      platform: platform,\n      external_id: externalId,\n      rating: item.json.rating || null,\n      content: item.json.snippet || null,\n      sentiment: parsed.sentiment,\n      sentiment_score: parsed.sentiment_score,\n      ai_analysis: {\n        summary: parsed.summary,\n        key_topics: parsed.key_topics\n      },\n      review_date: item.json.iso_date || item.json.date || null\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
