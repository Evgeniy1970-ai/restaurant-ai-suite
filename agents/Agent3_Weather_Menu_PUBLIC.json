    },
    {
      "parameters": {
        "jsCode": "// Get raw text from OpenAI response\nconst raw = $input.first().json.output[0].content[0].text;\n\n// Remove possible markdown fences (```json ... ```)\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\n// Try to parse JSON — catch error if GPT returned invalid format\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  // If parsing fails — return error object instead of crashing the workflow\n  return [{\n    json: {\n      error: true,\n      error_message: 'Failed to parse GPT response: ' + e.message,\n      raw_response: cleaned,\n      generated_at: new Date().toISOString(),\n      restaurant_id: 'e12f1eae-f48d-4c5f-ac9b-b9fd0f84e754'\n    }\n  }];\n}\n\n// Return structured result if parsing succeeded\nreturn [{\n  json: {\n    weather_summary: parsed.weather_summary,\n    recommendations: parsed.recommendations,\n    generated_at: new Date().toISOString(),\n    restaurant_id: 'e12f1eae-f48d-4c5f-ac9b-b9fd0f84e754'\n  }\n}];"
      },
